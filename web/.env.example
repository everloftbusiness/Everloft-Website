# ---------------------------------------------------------------------------
# Supabase (Auth + PostgreSQL) — the PMS foundation's database and auth.
# Get these from your Supabase project: Settings > API.
# ---------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL="https://xxxxxxxxxxxx.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="ey..."
SUPABASE_SECRET_KEY="sb_secret_..."          # server-only, never expose to the browser
SUPABASE_AUTH_GOOGLE_CLIENT_ID=""            # future ready — Google login
SUPABASE_AUTH_GOOGLE_SECRET=""

NEXT_PUBLIC_SITE_URL="http://localhost:3000" # used to build auth redirect URLs

# ---------------------------------------------------------------------------
# Cloudflare R2 (file storage) — S3-compatible, from Cloudflare dashboard >
# R2 > Manage API tokens.
# ---------------------------------------------------------------------------
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""            # only needed if you use a single shared bucket instead of per-purpose buckets
R2_PUBLIC_BASE_URL=""        # custom domain or r2.dev URL, once public access is enabled

# ---------------------------------------------------------------------------
# Cloudflare Turnstile (Bot Protection / CAPTCHA)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_TURNSTILE_SITE_KEY="" # Public site key used by client widget
TURNSTILE_SECRET_KEY=""           # Server-only secret key, never expose to browser

# ---------------------------------------------------------------------------
# Legacy marketing-site persistence (Prisma + SQLite) — the public site's
# property listings/reviews/leads, unrelated to the PMS foundation above.
# See web/CLAUDE.md "Two databases, on purpose (for now)".
# ---------------------------------------------------------------------------
DATABASE_URL="file:./dev.db"

# Real Everloft 3rd-party integrations, carried over from the legacy static
# site (contact form forwarding only — login now goes through Supabase Auth).
GOOGLE_CONTACT_SCRIPT_URL=""
# Public Google Sheet read via gviz (feeds the legacy-ported analytics
# dashboard's live occupancy/revenue widgets until those move onto Postgres).
NEXT_PUBLIC_EVERLOFT_SPREADSHEET_ID=""
