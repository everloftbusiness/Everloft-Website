// Everloft data model
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id           String    @id @default(cuid())
  name         String
  email        String    @unique
  passwordHash String
  phone        String?
  role         String    @default("GUEST") // GUEST | ADMIN | OWNER
  bookings     Booking[]
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
}

model Property {
  id            String          @id @default(cuid())
  slug          String          @unique
  name          String
  type          String // Villa | Apartment | Holiday Home | Boutique Stay | Penthouse | Luxury Home
  tagline       String?
  description   String
  city          String
  area          String?
  address       String
  latitude      Float?
  longitude     Float?
  guests        Int
  bedrooms      Int
  bathrooms     Int
  areaSqft      Int
  pricePerNight Float
  cleaningFee   Float           @default(0)
  serviceFeePct Float           @default(0.08)
  currency      String          @default("INR")
  rating        Float           @default(4.9)
  reviewCount   Int             @default(0)
  heroImage     String
  amenities     String // JSON string array
  highlights    String // JSON string array
  houseRules    String // JSON string array
  nearbyPlaces  String          @default("[]") // JSON array of { name, distance }
  featured      Boolean         @default(false)
  status        String          @default("PUBLISHED") // PUBLISHED | DRAFT
  images        PropertyImage[]
  reviews       Review[]
  bookings      Booking[]
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
}

model PropertyImage {
  id         String   @id @default(cuid())
  propertyId String
  property   Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  url        String
  alt        String   @default("")
  sortOrder  Int      @default(0)
}

model Review {
  id          String   @id @default(cuid())
  propertyId  String
  property    Property @relation(fields: [propertyId], references: [id], onDelete: Cascade)
  guestName   String
  guestAvatar String?
  rating      Int
  title       String?
  comment     String
  stayMonth   String?
  createdAt   DateTime @default(now())
}

model Booking {
  id              String   @id @default(cuid())
  reservationCode String   @unique
  propertyId      String
  property        Property @relation(fields: [propertyId], references: [id])
  userId          String?
  user            User?    @relation(fields: [userId], references: [id])
  checkIn         DateTime
  checkOut        DateTime
  nights          Int
  guests          Int
  guestName       String
  guestEmail      String
  guestPhone      String
  specialRequests String?
  subtotal        Float
  cleaningFee     Float
  serviceFee      Float
  taxes           Float
  couponCode      String?
  discount        Float    @default(0)
  total           Float
  currency        String   @default("INR")
  status          String   @default("PENDING") // PENDING | CONFIRMED | CANCELLED
  paymentStatus   String   @default("PENDING") // PENDING | PAID | FAILED
  paymentProvider String   @default("razorpay")
  paymentRef      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  phone     String?
  subject   String
  message   String
  createdAt DateTime @default(now())
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model OwnerLead {
  id           String   @id @default(cuid())
  name         String
  email        String
  phone        String
  city         String
  propertyType String
  bedrooms     Int?
  message      String?
  createdAt    DateTime @default(now())
}

model InvestorLead {
  id              String   @id @default(cuid())
  name            String
  email           String
  phone           String
  investmentRange String
  message         String?
  createdAt       DateTime @default(now())
}
